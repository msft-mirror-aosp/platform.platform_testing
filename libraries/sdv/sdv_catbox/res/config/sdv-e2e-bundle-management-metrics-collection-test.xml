<configuration description="SDV E2E Orchestration Binder Reconnect Test">
    <!-- Template for Device Configuration -->
    <template-include name="device-config" default="sdv-device-config/one-device" />

    <!-- Plan. Use the same name as the file name -->
    <option name="plan" value="sdv-e2e-bundle-management-metrics-collection-test"/>

    <!-- Test: mobly-par-file-name should match the module name -->
    <option name="mobly-host:mobly-par-file-name" value="BundleManagementMetricsCollectionTest" />

    <!-- Extra dependencies required for the test -->
    <!-- TODO(b/448843336): Use Android build libraries instead -->
    <!-- TODO(b/449630628): Remove when numpy import is replaced by AOSP library -->
    <device name="device1">
      <target_preparer class="com.android.tradefed.targetprep.PythonVirtualenvPreparer">
        <option name="dep-module" value="numpy" />
      </target_preparer>
    </device>

    <!-- Allow test to run for up to 30 minutes -->
    <!-- Test performs several reboots to average metrics -->
    <!-- This timeout is an exception. The test will not run in presubmit -->
    <option name="mobly-host:mobly-test-timeout" value="1800000" />
</configuration>
