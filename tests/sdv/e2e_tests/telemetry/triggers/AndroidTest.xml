<configuration description="E2E Tests validating trigger usage scenarios in Telemetry Service">
  <option name="test-suite-tag" value="sdv-catbox" />

  <device name="device1">
    <!-- ADB Root -->
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />

    <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer">
      <option name="cleanup" value="true"/>

      <!-- Act On Start Trigger Test -->
      <option name="push-file"
        key="act_on_start_trigger.textproto"
        value="/data/local/tmp/act_on_start_trigger.textproto"
      />

      <!-- Aggregation and reporting happening on Finish Trigger Test -->
      <option name="push-file"
        key="aggregate_report_finish_config.textproto"
        value="/data/local/tmp/aggregate_report_finish_config.textproto"
      />
      <option name="push-file"
        key="acceleration_publisher.textproto"
        value="/data/local/tmp/acceleration_publisher.textproto"
      />
      <option name="push-file"
        key="acceleration_publisher_data.csv"
        value="/data/local/tmp/acceleration_publisher_data.csv"
      />

      <!-- Distance Traveled Test -->
      <option name="push-file"
        key="distance_publisher.textproto"
        value="/data/local/tmp/distance_publisher.textproto"
      />
      <option name="push-file"
        key="distance_publisher_data.csv"
        value="/data/local/tmp/distance_publisher_data.csv"
      />
      <option name="push-file"
        key="distance_traveled.textproto"
        value="/data/local/tmp/distance_traveled.textproto"
      />
      <option name="push-file"
        key="event_publisher.textproto"
        value="/data/local/tmp/event_publisher.textproto"
      />
      <option name="push-file"
        key="event_publisher_data.csv"
        value="/data/local/tmp/event_publisher_data.csv"
      />

      <!-- Journey Status Test -->
      <option name="push-file"
        key="journey_config_sim_actions.textproto"
        value="/data/local/tmp/journey_config_sim_actions.textproto"
      />
      <option name="push-file"
        key="journey_source_data_first_off.csv"
        value="/data/local/tmp/journey_source_data_first_off.csv"
      />
      <option name="push-file"
        key="journey_source_data_first_on.csv"
        value="/data/local/tmp/journey_source_data_first_on.csv"
      />
      <option name="push-file"
        key="journey_source_publisher_first_off.textproto"
        value="/data/local/tmp/journey_source_publisher_first_off.textproto"
      />
      <option name="push-file"
        key="journey_source_publisher_first_on.textproto"
        value="/data/local/tmp/journey_source_publisher_first_on.textproto"
      />
      <option name="push-file"
        key="journey_status.textproto"
        value="/data/local/tmp/journey_status.textproto"
      />

      <!-- Lifecycle Triggers Test -->
      <option name="push-file"
        key="lifecycle_publisher.textproto"
        value="/data/local/tmp/lifecycle_publisher.textproto"
      />
      <option name="push-file"
        key="lifecycle_publisher_data.csv"
        value="/data/local/tmp/lifecycle_publisher_data.csv"
      />
      <option name="push-file"
        key="lifecycle_triggers.textproto"
        value="/data/local/tmp/lifecycle_triggers.textproto"
      />

      <!-- Periodic Triggers Test -->
      <option name="push-file"
        key="periodic_trigger.textproto"
        value="/data/local/tmp/periodic_trigger.textproto"
      />
    </target_preparer>
  </device>

  <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
    <!-- The mobly-par-file-name should match the module name -->
    <option name="mobly-par-file-name" value="SdvE2ETelemetryTriggersTest" />
    <!-- Timeout limit in milliseconds for all test cases of the python binary -->
    <option name="mobly-test-timeout" value="180000" />
    <!-- Testbed config file -->
    <option name="mobly-config-file-name" value="sdv_one_device_config_local.yaml" />
  </test>
</configuration>