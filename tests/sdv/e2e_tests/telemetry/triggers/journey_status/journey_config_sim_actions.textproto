# Add and activate metrics configuration only after 50ms after the simulation start, to simulate
# that the actual journey status has been published before in advance.

actions {
  delay {
    # timestamp = 50ms
    nanos: 50000000
  }
  metrics_config_action { config_uuid: "bcbffd01-42ba-4444-ae35-908b907c48b8" action_type: ADD }
}
actions {
  delay {
    # timestamp = 50ms
    seconds: 0
  }
  metrics_config_action {
    config_uuid: "bcbffd01-42ba-4444-ae35-908b907c48b8"
    action_type: ACTIVATE
  }
}
actions {
  delay {
    # timestamp = 950ms
    nanos: 900000000
  }
  remove_all_metrics_configs_action {}
}