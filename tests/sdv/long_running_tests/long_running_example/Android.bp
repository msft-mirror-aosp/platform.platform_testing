package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

// One VM example test
python_test_host {
    name: "SdvOneDeviceLongRunningExampleTest",
    main: "sdv_long_running_example_test_1vm.py",
    srcs: [
        "long_running_common.py",
        "sdv_long_running_example_test_1vm.py",
    ],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_one_device_long_running_test",
}

