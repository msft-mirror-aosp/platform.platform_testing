<configuration description="SDV Three Devices Long Running Configuration">
  <!-- Include SDV Base Configuration For Mobly Tests -->
  <include name="sdv-device-config/three-devices"/>

  <!-- Long Running Test - 30 hours timeout: for long running tests -->
  <!-- Note: Currently, only 10 hours of execution is possible in CI/CD (b/431979898) -->
  <option name="mobly-host:mobly-test-timeout" value="108000000" />
</configuration>
