package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

// Platform-untrusted key for testing purposes.
// Do not configure it in make files.
apex_key {
    name: "com.android.sdv.test.untrusted.key",
    public_key: "com.android.sdv.test.untrusted.avbpubkey",
    private_key: "com.android.sdv.test.untrusted.pem",
    installable: false,
}

apex_test {
    name: "com.android.sdv.test.preinstalled_untrusted_v2",
    defaults: [
        "com.sdv.google.sample.hello.apex.defaults",
    ],
    manifest: "apex_manifest_preinstalled_untrusted_v2.json",
    key: "com.android.sdv.test.untrusted.key",
    installable: false,
}

apex_test {
    name: "com.android.sdv.test.untrusted_brand_new",
    defaults: [
        "com.sdv.google.sample.hello.apex.defaults",
    ],
    manifest: "apex_manifest_untrusted_brand_new.json",
    key: "com.android.sdv.test.untrusted.key",
    installable: false,
}
