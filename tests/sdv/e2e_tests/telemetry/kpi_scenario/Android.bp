package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_test_host {
    name: "SdvE2ETelemetryKpiScenarioTest",
    main: "sdv_e2e_telemetry_kpi_scenario_test.py",
    srcs: [
        "metrics.py",
        "sdv_e2e_telemetry_kpi_scenario_test.py",
    ],
    libs: [
        // keep-sorted start
        "sdv_telemetry_scenario_generator_library",
        "sdv_telemetry_test_execution_library",
        // keep-sorted end
    ],
    test_options: {
        unit_test: false,
    },
    data: [
        ":sdv_test_fw_device_configs",
    ],
    defaults: [
        "sdv_perfetto_defaults",
        "sdv_perfetto_trace_processor_defaults",
        "sdv_test_fw_defaults",
    ],
    // Required for PythonVirtualenvPreparer dependencies.
    // TODO(b/449630628): Remove when numpy dep is replaced by AOSP library.
    embedded_launcher: false,
}
