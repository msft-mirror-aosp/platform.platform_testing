<configuration description="SDV Media Audio Playback Test">
  <!--
      SDV Media Audio Playback Test
      We cannot use the default SDV template because it is required to push files to the device
  -->
  <option name="test-suite-tag" value="sdv-catbox" />

  <!-- Extra dependencies required for the test -->
  <!-- TODO(b/448843336): Use Android build libraries instead -->
  <!-- TODO(b/449630628): Remove when numpy import is replaced by AOSP library -->
  <target_preparer class="com.android.tradefed.targetprep.PythonVirtualenvPreparer">
    <option name="dep-module" value="numpy" />
  </target_preparer>

  <!-- ADB Root -->
  <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />

  <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer">
        <option name="cleanup" value="true" />
        <option name="push-file"
                key="mixer.conf"
                value="/data/local/tmp/mixer.conf"
        />
        <option name="push-file"
                key="victory.wav"
                value="/data/local/tmp/victory.wav"
        />
        <option name="push-file"
                key="Road_Trip.48000.wav"
                value="/data/local/tmp/Road_Trip.48000.wav"
        />
  </target_preparer>

  <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
    <!-- The mobly-par-file-name should match the module name -->
    <option name="mobly-par-file-name" value="SdvSampleMediaAudioPlaybackTest" />
    <!-- Timeout limit in milliseconds for all test cases of the python binary -->
    <option name="mobly-test-timeout" value="300000" />
    <!-- Testbed config file -->
    <option name="mobly-config-file-name" value="sdv_one_device_config_local.yaml" />
  </test>
</configuration>
