package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: [
        "sdv_tests_license",
    ],
}

rust_protobuf {
    name: "libservice_discovery_test_service_proto",
    crate_name: "service_discovery_test_service_proto",
    grpc_protos: ["proto/service_discovery.proto"],
    source_stem: "service_discovery_test_service",
    vendor: true,
}

