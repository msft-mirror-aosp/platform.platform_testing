package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

// TODO(b/358394708): Remove generetd code and following rule once Python version issue is fixed.
// If removed, ensure to move the libs dependency into the client.
python_library_host {
    name: "sdv_service_discovery_test_grpc_generated",
    pkg_path: "sdv_service_discovery_test_grpc",
    srcs: [
        "generated/*.py",
    ],
    libs: [
        "libprotobuf-python",
        "py-grpcio",
    ],
}

python_library_host {
    name: "sdv_service_discovery_test_client",
    pkg_path: "sdv_service_discovery_test_client",
    srcs: [
        "client/service_discovery_client.py",
    ],
    libs: [
        "sdv_service_discovery_test_grpc_generated",
        // TODO(b/358394708): Replace sdv_service_discovery_test_grpc_generated with py_libservice_discovery_test_service_proto once Python version issue is fixed.
        // "py_libservice_discovery_test_service_proto",
    ],
}
