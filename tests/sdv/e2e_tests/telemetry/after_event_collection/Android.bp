package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_tests_license"],
    default_visibility: ["//visibility:private"],
}

python_test_host {
    name: "SdvE2ETelemetryAfterEventCollectionTest",
    main: "sdv_e2e_telemetry_after_event_collection_test.py",
    srcs: [
        // keep-sorted start
        "sdv_e2e_telemetry_after_event_collection_test.py",
        // keep-sorted end
    ],
    libs: [
        // keep-sorted start
        "sdv_telemetry_test_execution_library",
        // keep-sorted end
    ],
    test_options: {
        unit_test: false,
    },
    data: [
        ":sdv_test_fw_device_configs",
        "after_event_collection_config.textproto",
        "non_overlapping_event_publisher.textproto",
        "non_overlapping_event_publisher_data.csv",
        "overlapping_event_publisher.textproto",
        "overlapping_event_publisher_data.csv",
        "speed.textproto",
        "speed_data.csv",
    ],
    defaults: [
        "sdv_test_fw_defaults",
    ],
}
