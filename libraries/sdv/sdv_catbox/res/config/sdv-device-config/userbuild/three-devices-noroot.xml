<configuration description="SDV Three Devices Configuration">
  <!--
      Template for SDV no-rooted Three Devices Test.
      This is not a common template and is used for specific tests without
      root enabled.
      This configuration can be used in User Build testing,
      where devices never have root, but only adb enabled.
  -->
  <include name="common/sdv-catbox-base-mobly"/>

  <device name="device1">
    <build_provider class="com.android.compatibility.common.tradefed.build.CompatibilityBuildProvider" />
  </device>

  <device name="device2">
    <build_provider class="com.android.compatibility.common.tradefed.build.CompatibilityBuildProvider" />
  </device>

  <device name="device3">
    <build_provider class="com.android.compatibility.common.tradefed.build.CompatibilityBuildProvider" />
  </device>

  <!-- Testbed config file -->
  <option name="mobly-host:mobly-config-file-name" value="sdv_three_devices_config.yaml" />

  <!-- For 3VMs is 10 mins to take into consideration the extra VM -->
  <option name="mobly-host:mobly-test-timeout" value="600000" />
</configuration>
