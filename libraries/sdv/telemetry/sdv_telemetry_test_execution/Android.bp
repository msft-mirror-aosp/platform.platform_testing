package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_visibility: ["//visibility:private"],
}

python_library_host {
    name: "sdv_telemetry_test_execution_library",
    visibility: [
        // keep-sorted start
        "//platform_testing/tests/sdv/e2e_tests/telemetry:__subpackages__",
        "//platform_testing/tests/sdv/hardware/telemetry:__subpackages__",
        "//platform_testing/tests/sdv/long_running_tests/telemetry:__subpackages__",
        "//platform_testing/tests/sdv/sample_tests/telemetry:__subpackages__",
        "//platform_testing/tests/sdv/tests/performance_tests/telemetry:__subpackages__",
        // keep-sorted end
    ],
    // `pkg_path` SHOULD match the folder name, otherwise autocomplete in IDEs
    // will not work.
    pkg_path: "sdv_telemetry_test_execution",
    srcs: [
        "**/*.py",
    ],
    libs: [
        // keep-sorted start
        "libprotobuf-python",
        "libsdv_telemetry_proto_python",
        "sdv_test_fw_lib",
        // keep-sorted end
    ],
}

python_test_host {
    name: "sdv_telemetry_test_execution_library_unit_tests",
    main: "expects_test.py",
    srcs: [
        // keep-sorted start
        "expects_test.py",
        // keep-sorted end
    ],
    libs: [
        // keep-sorted start
        "sdv_telemetry_test_execution_library",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        "sdv-host-unit-tests",
        // keep-sorted end
    ],
    test_options: {
        unit_test: true,
    },
}
