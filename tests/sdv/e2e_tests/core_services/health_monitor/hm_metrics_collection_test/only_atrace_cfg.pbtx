# Copyright 2025 Google LLC

# See `default_trace_cfg.pbtx` for a documented example of config file

write_into_file: true
file_write_period_ms: 3000

flush_period_ms: 5000

buffers: {
    size_kb: 32768
    fill_policy: RING_BUFFER
}

data_sources: {
    config {
        name: "linux.ftrace"
        ftrace_config {
            # 'atrace_app' name is determined by parsing first argument of cmdline used to start the process,
            # glob operator works. See:
            # https://source.corp.google.com/h/android/platform/superproject/main/+/main:system/core/libcutils/trace-dev.inc;l=118;drc=61197364367c9e404c7da6900658f1b16c42d0da
             atrace_apps: "*sdv_health_monitor*"
             atrace_apps: "*test_vm_health_subscriber*"
             atrace_apps: "*ServiceBundle*"
        }
    }
}