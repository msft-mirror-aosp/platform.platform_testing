        avg_aggregation { expression_node_index: 0 }
      }
      field_assignments {
        field_name: "count_meters_per_hour"
        count_aggregation {}
      }
      field_assignments {
        field_name: "sum_meters_per_hour"
        sum_aggregation { expression_node_index: 0 }
      }
      field_assignments {
        field_name: "stddev_meters_per_hour"
        std_dev_aggregation { expression_node_index: 0 }
      }
      field_assignments {
        field_name: "delta_meters_per_hour"
        delta_aggregation { expression_node_index: 0 }
      }
    }
  }
}
