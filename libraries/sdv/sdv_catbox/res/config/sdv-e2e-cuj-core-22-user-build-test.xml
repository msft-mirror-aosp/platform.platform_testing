<!-- TODO(b/402089309): Deprecate test when b/383592250 and b/403259181 are ready. -->
<configuration description="SDV e2e CUJ Core 22 Test for User Build">
   <!--
      User build testing requires two devices to be running:
        * User build VM / "VM under test".
        * UserDebug or Eng build VM / "Proxy VM".
      Meanwhile, SDV test framework does not recognize user builds as existing device.
      This force to use `one-devices` template.

      Note: CI/CD configuration still should create 2 VMs: Userdebug and User.
  -->
    <template-include name="device-config" default="sdv-device-config/userbuild/one-device-noroot" />

    <!-- Plan. Use the same name as the file name -->
    <option name="plan" value="sdv-e2e-cuj-core-22-user-build-test"/>

    <!-- Test: mobly-par-file-name should match the module name -->
    <option name="mobly-host:mobly-par-file-name" value="SdvE2ECujCore22TestUserBuildTest" />
</configuration>
