uuid: "aa27883c-96a5-4a67-adad-dcce00c0f12a"
version: 1

descriptor_protos {
  message_type {
    name: "IntList"
    field { type: TYPE_INT64 name: "values" label: LABEL_REPEATED number: 1 }
  }
  message_type {
    name: "Report"
    field { type: TYPE_INT64 name: "values" label: LABEL_REPEATED number: 1 }
  }
}

publishers {
  name: "counting_publisher"
  service_publisher { service_name: "SimulationCountingPublisher" }
}

triggers {
  name: "counting_publisher_trigger"
  data_trigger { publisher_name: "counting_publisher" }
}

# Triggers whenever `counting_publisher_trigger` triggers, but only after the
# first 30 seconds after boot or resume.
triggers {
  name: "finish_trigger"
  conditional_trigger {
    trigger_names: "counting_publisher_trigger"
    selector_node_index: 3
    is_true {}
  }
}

# Triggers whenever `counting_publisher_trigger` triggers, but only during the
# first 30 seconds after boot or resume.
triggers {
  name: "filtered_counting_publisher_trigger"
  conditional_trigger {
    trigger_names: "counting_publisher_trigger"
    selector_node_index: 3
    is_false {}
  }
}

publishers {
  name: "aggregation_publisher"
  aggregation_publisher {
    trigger_names: "filtered_counting_publisher_trigger"
    reset_on_get: false
    message_builder {
      message_type: ".IntList"
      field_assignments {
        field_name: "values"
        vector_aggregation { expression_node_index: 0 max_length: 1000 }
      }
    }
  }
}

# index 0
expression_nodes { field_leaf_node { publisher_name: "counting_publisher" field_names: "value" } }

# index 1
expression_nodes {
  function_leaf_node { get_current_timestamp { time_source: MONOTONIC_TIME_SINCE_BOOT_OR_RESUME } }
}

# index 2
expression_nodes {
  constant_leaf_node {
    int64_value: 30000000  # 30 seconds
  }
}

# index 3
expression_nodes { combination_node { relational_operator: GT_OR_EQ left_index: 1 right_index: 2 } }

# index 4
expression_nodes {
  field_leaf_node { publisher_name: "aggregation_publisher" field_names: "values" }
}

finish_trigger_name: "finish_trigger"

metrics_report_configs {
  name: "values"
  trigger_names: "finish_trigger"
  report_incomplete: false

  message_builder {
    message_type: ".Report"
    field_assignments {
      field_name: "values"
      no_aggregation { expression_node_index: 4 }
    }
  }
}
