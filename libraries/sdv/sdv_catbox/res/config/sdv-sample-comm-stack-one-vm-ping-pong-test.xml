<configuration description="SDV Sample Comm Stack One VM Ping-Pong Notifications Latency Test">
  <!-- Template for Device Configuration -->
  <template-include name="device-config" default="sdv-device-config/one-device" />

  <!-- Plan. Use the same name as the file name -->
  <option name="plan" value="sdv-sample-comm-stack-one-vm-ping-pong-test"/>

  <!-- Test: mobly-par-file-name should match the module name -->
  <option name="mobly-host:mobly-par-file-name" value="SdvSampleCommStackOneVMPingPongTest" />

  <!-- Extra dependencies required for the test -->
  <!-- TODO(b/448843336): Use Android build libraries instead -->
  <!-- TODO(b/449630628): Remove when numpy import is replaced by AOSP library -->
  <device name="device1">
    <target_preparer class="com.android.tradefed.targetprep.PythonVirtualenvPreparer">
      <!-- Required for sdv_comm_helper_lib -->
      <option name="dep-module" value="numpy" />
    </target_preparer>
  </device>
</configuration>
