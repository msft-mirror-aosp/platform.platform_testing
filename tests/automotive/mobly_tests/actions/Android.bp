package {
    default_team: "trendy_team_aaos_framework",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "actions_golden_images",
    srcs: [
        "golden_images/**/*.png",
    ],
}

python_library_host {
    name: "actions_golden_images_lib",
    pkg_path: "actions_golden_images",
    data: [
        ":actions_golden_images",
    ],
}

python_test_host {
    name: "ActionsGears",
    main: "gears.py",
    srcs: [
        "actions_common.py",
        "gears.py",
    ],
    libs: [
        "functional_test_library",
    ],
    test_suites: [
        "catbox",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "spectatio_host_tf_defaults",
    ],
    device_common_data: [
        ":AutomotiveSnippet",
        "actions_config.yaml",
    ],
}

python_test_host {
    name: "ActionsHvac",
    main: "hvac.py",
    srcs: [
        "actions_common.py",
        "hvac.py",
    ],
    libs: [
        "actions_golden_images_lib",
        "functional_test_library",
    ],
    test_suites: [
        "catbox",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "spectatio_host_tf_defaults",
    ],
}

python_test_host {
    name: "MediaKeys",
    main: "media.py",
    srcs: [
        "media.py",
    ],
    libs: [
        "actions_golden_images_lib",
        "functional_test_library",
    ],
    test_suites: [
        "catbox",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "spectatio_host_tf_defaults",
    ],
    device_common_data: [
        ":AutomotiveSnippet",
    ],
}

python_test_host {
    name: "ActionsSensors",
    main: "sensors.py",
    srcs: [
        "actions_common.py",
        "sensors.py",
    ],
    libs: [
        "actions_golden_images_lib",
        "functional_test_library",
    ],
    test_suites: [
        "catbox",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "spectatio_host_tf_defaults",
    ],
}
