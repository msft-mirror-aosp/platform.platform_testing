service_name: "com.google.sdv.telemetry.JourneySource"
data_format_protos {
  name: "journey_source.proto"
  package: "com.google.sdv.telemetry"
  message_type {
    name: "JourneySource"
    field { name: "status" number: 1 type: TYPE_BOOL json_name: "boolean" }
  }
}
data_format_message_name: ".com.google.sdv.telemetry.JourneySource"
data_generators {
  loop_data: false
  default_delay { seconds: 1 nanos: 0 }
  csv_file { file_path: "/data/local/tmp/journey_source_data_first_off.csv" delimiter: "," }
}
publishing_strategy { sdv_comms_data_tunnel { message_count: 200 message_size: 20 } }
