package {
    default_applicable_licenses: ["sdv_tests_license"],
}

python_library_host {
    name: "sdv_comm_helper_lib",
    srcs: [
        "helper.py",
    ],
    libs: [],
    // Required for PythonVirtualenvPreparer dependencies.
    // TODO(b/449630628): Remove when numpy dep is replaced by AOSP library.
    embedded_launcher: false,
}

// Config files with required dependencies.
// TODO(b/449630628): Remove when numpy dep is replaced by AOSP library and use
// default templates in tests instead.

filegroup {
    name: "sdv_comm_helper_config_one_vm",
    srcs: ["sdv_comm_helper_one_vm.xml"],
}

filegroup {
    name: "sdv_comm_helper_config_two_vm",
    srcs: ["sdv_comm_helper_two_vm.xml"],
}
