package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_library_host {
    name: "sdv_rob_base_test_lib",
    srcs: [
        "sdv_rob_base_test.py",
    ],
    pkg_path: "robustness",
    libs: [
        "cuj22_common_lib",
        "sdv_vpm_lib",
    ],
}

python_test_host {
    name: "SdvRobCuj001Test",
    main: "cuj_rob_001_test.py",
    data: [":sdv_test_fw_device_configs"],
    srcs: ["cuj_rob_001_test.py"],
    test_options: {
        unit_test: false,
    },
    defaults: ["sdv_test_fw_defaults"],
    libs: [
        "sdv_rob_base_test_lib",
    ],
    test_config_template: ":sdv_two_devices",
}

