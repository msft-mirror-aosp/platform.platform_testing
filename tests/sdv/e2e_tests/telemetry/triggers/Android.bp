package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_tests_license"],
    default_visibility: ["//visibility:private"],
}

python_test_host {
    name: "SdvE2ETelemetryTriggersTest",
    main: "sdv_e2e_telemetry_triggers_test.py",
    srcs: [
        // keep-sorted start
        "sdv_e2e_telemetry_triggers_test.py",
        // keep-sorted end
    ],
    libs: [
        // keep-sorted start
        "sdv_telemetry_test_execution_library",
        // keep-sorted end
    ],
    test_options: {
        unit_test: false,
    },
    data: [
        // keep-sorted start
        ":sdv_test_fw_device_configs",
        "act_on_start_trigger/act_on_start_trigger.textproto",
        "aggregate_report_finish/acceleration_publisher.textproto",
        "aggregate_report_finish/acceleration_publisher_data.csv",
        "aggregate_report_finish/aggregate_report_finish_config.textproto",
        "distance_traveled/distance_publisher.textproto",
        "distance_traveled/distance_publisher_data.csv",
        "distance_traveled/distance_traveled.textproto",
        "distance_traveled/event_publisher.textproto",
        "distance_traveled/event_publisher_data.csv",
        "journey_status/journey_config_sim_actions.textproto",
        "journey_status/journey_source_data_first_off.csv",
        "journey_status/journey_source_data_first_on.csv",
        "journey_status/journey_source_publisher_first_off.textproto",
        "journey_status/journey_source_publisher_first_on.textproto",
        "journey_status/journey_status.textproto",
        "lifecycle_triggers/lifecycle_publisher.textproto",
        "lifecycle_triggers/lifecycle_publisher_data.csv",
        "lifecycle_triggers/lifecycle_triggers.textproto",
        "lifecycle_triggers/lifecycle_triggers_retaining_aggregators.textproto",
        "periodic_trigger/periodic_trigger.textproto",
        // keep-sorted end
    ],
    defaults: [
        "sdv_test_fw_defaults",
    ],
}
