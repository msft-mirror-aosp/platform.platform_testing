package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
        "vendor_google_testing_sdv_catbox_src_license",
    ],
}

// See: http://go/android-license-faq
license {
    name: "vendor_google_testing_sdv_catbox_src_license",
    visibility: [":__subpackages__"],
    license_kinds: ["legacy_proprietary"],
}

// Build SDV Test Plans
java_test_helper_library {
    name: "sdv-config-lib",
    java_resource_dirs: ["res"],
    test_suites: [
        "catbox",
    ],
    // Test plan is used as the host and not deployed to an SDV device.
    host_supported: true,
    device_supported: false,
}
