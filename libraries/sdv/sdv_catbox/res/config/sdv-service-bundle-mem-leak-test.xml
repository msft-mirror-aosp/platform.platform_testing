<configuration description="SDV service bundle memory leak detection test">
    <!-- Template for Device Configuration -->
    <template-include name="device-config" default="sdv-device-config/two-devices" />

    <!-- Plan. Use the same name as the file name -->
    <option name="plan" value="sdv-service-bundle-mem-leak-test"/>

    <!-- Test: mobly-par-file-name should match the module name -->
    <option name="mobly-host:mobly-par-file-name" value="SdvServiceBundleMemLeakTest" />

    <!-- This is for long running tests. -->
    <option name="mobly-host:mobly-test-timeout" value="108000000" />

    <!-- Test args passed to the test  -->
    <option name="mobly-options" value="--test_args=trace_config=service_bundle_mem_trace.pbtxt" />
    <option name="mobly-options" value="--test_args=start_stop_repeated_times=3" />
    <option name="mobly-options" value="--test_args=interval_ms=30" />
    <option name="mobly-options" value="--test_args=load_size_bytes=300000" />
    <option name="mobly-options" value="--test_args=message_amount=10" />
</configuration>