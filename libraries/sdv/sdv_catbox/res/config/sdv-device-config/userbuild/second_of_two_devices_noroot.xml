<configuration description="SDV Second of Two Devices No Root Test Catbox Configuration">
  <!--
    Template for SDV User Build Two Device Test without root on the second device.
    This is not a common template and is used for specific tests without
    root enabled.
  -->
  <!-- Include SDV Base Configuration For Mobly Tests -->
  <include name="common/sdv-catbox-base-mobly"/>

  <device name="device1">
    <build_provider class="com.android.compatibility.common.tradefed.build.CompatibilityBuildProvider" />

    <!-- ADB Root -->
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />

  </device>

  <device name="device2">
    <build_provider class="com.android.compatibility.common.tradefed.build.CompatibilityBuildProvider" />
  </device>

  <!-- Testbed config file -->
  <option name="mobly-host:mobly-config-file-name" value="sdv_two_devices_config.yaml" />
</configuration>