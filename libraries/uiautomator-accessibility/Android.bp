// Enables accessibility checks for UiAutomator tests using Accessibility Test Framework. The checks
// will run automatically on every test action like click(), swipe() etc. See
// PlatformUiAutomatorAccessibilityTestRule.kt for details.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "uiautomator-accessibility_defaults",
    manifest: "AndroidManifest.xml",
    lint: {
        test: true,
    },
    optimize: {
        enabled: false,
    },
    static_libs: [],
}

android_library {
    name: "uiautomator-accessibility",
    defaults: ["uiautomator-accessibility_defaults"],
    static_libs: [
        // This lib should have minimal dependencies, and never depend on sysui or launcher targets.
        "androidx.test.uiautomator_uiautomator",
        "androidx.test.runner",
        "androidx.test.rules",
        "aatf",
        "truth",
        "junit",
    ],
    libs: [
        "hamcrest-library",
        "microbenchmark-device-lib",
    ],

    srcs: [
        // Note: this library should be kotlin first.
        // Unless absolutely necessary, try not to add java files here.
        "src/**/*.java",
        "src/**/*.kt",
    ],
}
