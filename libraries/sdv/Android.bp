package {
    default_applicable_licenses: ["sdv_tests_license"],
}

license {
    name: "sdv_tests_license",
    visibility: [
        ":__subpackages__",
        "//platform_testing/tests/sdv:__subpackages__",
        "//vendor:__subpackages__",
