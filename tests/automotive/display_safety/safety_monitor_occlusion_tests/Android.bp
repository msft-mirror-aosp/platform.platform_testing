package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_test_host {
    name: "SafetyMonitorOcclusionTest",
    main: "safety_monitor_occlusion_test.py",
    srcs: [
        "safety_monitor_occlusion_test.py",
    ],
    data: [
        ":spectatio_host_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "spectatio_host_tf_defaults",
    ],
    test_suites: [
        "general-tests",
        "general-automotive-tests",
    ],
    libs: [
        "display_safety_test_lib",
    ],
    test_config_template: ":display_safety_test_config_one_device",
}
