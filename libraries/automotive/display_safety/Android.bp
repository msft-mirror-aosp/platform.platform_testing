package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_library_host {
    name: "display_safety_test_lib",
    pkg_path: "display_safety_test",
    srcs: [
        "test_base/*.py",
    ],
    defaults: [
        "spectatio_host_tf_defaults",
    ],
    libs: [
        // keep-sorted start
        "ai_util_library",
        "display_safety_test_client",
        "display_safety_utils_library",
        "file_utils_library",
        "host_orchestrator_util_library",
        "image_comparison_library",
        // keep-sorted end
    ],
}
