<configuration description="SDV Sample Media Audio Playback Test">
    <!-- Template for Device Configuration -->
    <template-include name="device-config" default="sdv-device-config/one-device" />

    <!-- Plan. Use the same name as the file name -->
    <option name="plan" value="sdv-sample-media-audio-playback-test"/>

    <!-- Automatically pushes config file to device-->
    <device name="device1">
      <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer">
            <option name="cleanup" value="true" />
            <option name="push-file"
                    key="mixer.conf"
                    value="/data/local/tmp/mixer.conf"
            />
            <option name="push-file"
                    key="victory.wav"
                    value="/data/local/tmp/victory.wav"
            />
            <option name="push-file"
                    key="Road_Trip.48000.wav"
                    value="/data/local/tmp/Road_Trip.48000.wav"
            />
      </target_preparer>

      <!-- Extra dependencies required for the test -->
      <!-- TODO(b/448843336): Use Android build libraries instead -->
      <!-- TODO(b/449630628): Remove when numpy import is replaced by AOSP library -->
      <target_preparer class="com.android.tradefed.targetprep.PythonVirtualenvPreparer">
        <option name="dep-module" value="numpy" />
      </target_preparer>
    </device>

    <!-- Test: mobly-par-file-name should match the module name -->
    <option name="mobly-host:mobly-par-file-name" value="SdvSampleMediaAudioPlaybackTest" />
</configuration>
