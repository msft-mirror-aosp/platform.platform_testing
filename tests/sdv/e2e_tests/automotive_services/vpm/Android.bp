package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_test_host {
    name: "SdvVpmPowerStatePersistenceTest",
    // IMPORTANT: This name must match the name used in the test definition file.
    main: "sdv-vpm-power-state-persistence-test.py",
    srcs: ["sdv-vpm-power-state-persistence-test.py"],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    // IMPORTANT: For two devices tests use ":sdv_two_devices" template.
    test_config_template: ":sdv_one_device",
}

python_test_host {
    name: "SdvVpmSuspendTest",
    main: "sdv-vpm-power-suspend.py",
    srcs: ["sdv-vpm-power-suspend.py"],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    libs: [
        "sdv_vpm_lib",
    ],
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_one_device",
}

python_test_host {
    name: "SdvE2EVpmCancelShutDownTest",
    main: "sdv-e2e-vpm-power-cancel-shutdown.py",
    srcs: ["sdv-e2e-vpm-power-cancel-shutdown.py"],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    libs: [
        "sdv_vpm_lib",
    ],
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_one_device",
}
