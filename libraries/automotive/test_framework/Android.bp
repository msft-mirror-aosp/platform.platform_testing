// Copyright 2025 Google LLC
package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Spectatio Host-Side Automotive Test Framework (tf) Library
python_library_host {
    name: "spectatio_host_tf_lib",
    pkg_path: "spectatio_host_tf",
    srcs: [
        "**/*.py",
    ],
    libs: [
        "mobly",
    ],
}

// Spectatio Host-Side Automotive Test Framework (tf) Defaults
python_defaults {
    name: "spectatio_host_tf_defaults",
    libs: [
        "spectatio_host_tf_lib",
    ],
    test_suites: [
        "catbox",
    ],
    embedded_launcher: false,
}
