package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_library_host {
    name: "sdv_perf_dashboard_lib",
    pkg_path: "sdv_perf_dashboard",
    srcs: [
        "crystalball_exporter.py",
    ],
    libs: [
    ],

}

python_test_host {
    name: "sdv_crystalball_exporter_test",
    srcs: ["crystalball_exporter_test.py"],
    main: "crystalball_exporter_test.py",
    libs: [
        "sdv_perf_dashboard_lib",
    ],
    test_options: {
        unit_test: true,
    },
}
