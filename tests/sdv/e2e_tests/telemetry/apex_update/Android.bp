package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_test_host {
    name: "SdvE2ETelemetryApexUpdateTest",
    main: "sdv_e2e_telemetry_apex_update_test.py",
    srcs: [
        // keep-sorted start
        "sdv_e2e_telemetry_apex_update_test.py",
        "update_manager_client.py",
        // keep-sorted end
    ],
    libs: [
        // keep-sorted start
        "sdv_telemetry_test_execution_library",
        // keep-sorted end
    ],
    test_options: {
        unit_test: false,
    },
    device_common_data: [":com.sdv.google.sample.apex.provider.v2"],
    data: [
        ":sdv_test_fw_device_configs",
        "apex_update_metrics_config.textproto",
    ],
    defaults: [
        "sdv_test_fw_defaults",
    ],
}
