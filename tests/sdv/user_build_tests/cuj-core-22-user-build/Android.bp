package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["sdv_tests_license"],
}

// SDV e2e 'CUJ-Core-22' test for user build.
// The test is based on CORE-CUJ catalog and 'CUJ-Core-22' sample.
// TODO(b/402089309): Deprecate test when b/383592250 and b/403259181 are ready.
python_test_host {
    name: "SdvE2ECujCore22TestUserBuildTest",
    main: "sdv_e2e_cuj_core_22_user_build_test.py",
    srcs: ["sdv_e2e_cuj_core_22_user_build_test.py"],
    data: [":sdv_test_fw_device_configs"],
    test_options: {
        unit_test: false,
    },
    defaults: ["sdv_test_fw_defaults"],
    test_config_template: ":sdv_one_device_noroot",
}
