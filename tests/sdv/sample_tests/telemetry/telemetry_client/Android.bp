package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_test_host {
    name: "SdvSampleTelemetryClientTest",
    main: "sdv_sample_telemetry_client_test.py",
    srcs: ["sdv_sample_telemetry_client_test.py"],
    libs: [
        // keep-sorted start
        "sdv_telemetry_test_execution_library",
        // keep-sorted end
    ],
    data: [
        ":sdv_test_fw_device_configs",
        ":metric_config",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
}

filegroup {
    name: "metric_config",
    srcs: ["metric_config.textproto"],
}
