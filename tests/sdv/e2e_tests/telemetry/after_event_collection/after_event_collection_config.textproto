# Expression Node 6
expression_nodes { constant_leaf_node { int32_value: 5000000 } }
# Expression Node 7
expression_nodes { combination_node { left_index: 5 right_index: 6 relational_operator: GT_OR_EQ } }
# Expression Node 8
expression_nodes { combination_node { left_index: 2 right_index: 7 logical_operator: OR } }
# Expression Node 9
expression_nodes {
  function_leaf_node { get_current_timestamp { time_source: MONOTONIC_TIME_SINCE_BOOT } }
}
# Expression Node 10
expression_nodes { combination_node { left_index: 9 right_index: 3 arithmetic_operator: SUBTRACT } }
# Expression Node 11
expression_nodes {
