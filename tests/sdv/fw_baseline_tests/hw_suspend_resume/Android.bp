package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

// Single VM test
python_test_host {
    name: "SdvBaselineHwSuspendResumeOneVMTest",
    main: "sdv_baseline_hw_suspend_resume_1vm_test.py",
    srcs: [
        "sdv_baseline_hw_suspend_resume_1vm_test.py",
        "sdv_baseline_hw_suspend_resume_mixin.py",
        "sdv_baseline_hw_suspend_resume_test_verification.py",
    ],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_one_device",
}

// Two VMs test
python_test_host {
    name: "SdvBaselineHwSuspendResumeTwoVMTest",
    main: "sdv_baseline_hw_suspend_resume_2vm_test.py",
    srcs: [
        "sdv_baseline_hw_suspend_resume_2vm_test.py",
        "sdv_baseline_hw_suspend_resume_mixin.py",
        "sdv_baseline_hw_suspend_resume_test_verification.py",
    ],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_two_devices",
}
