package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_library_host {
    name: "sdv_ivi_rob_base_test_lib",
    srcs: [
        "sdv_ivi_rob_base_test.py",
    ],
    pkg_path: "robustness",
    libs: [
        "sdv_vpm_lib",
    ],
}

python_defaults {
    name: "sdv_ivi_rob_cuj_test_defaults",
    defaults: [
        "sdv_test_fw_defaults",
    ],
    libs: [
        "sdv_sb_lifecycle_robustness_lib",
        "sdv_ivi_rob_base_test_lib",
        "sdv_vpm_lib",
    ],
}

python_test_host {
    name: "SdvIviRobCujTest",
    main: "cuj-rob-ivi.py",
    srcs: ["cuj-rob-ivi.py"],

    defaults: ["sdv_ivi_rob_cuj_test_defaults"],
    test_options: {
        unit_test: false,
    },
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_config_template: ":sdv_two_devices_long_running_test",
}
