package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_tests_license"],
    default_visibility: ["//visibility:private"],
}

python_test_host {
    name: "SdvSampleTelemetryConfigurablePublisherTest",
    main: "sdv_sample_telemetry_configurable_publisher_test.py",
    srcs: ["sdv_sample_telemetry_configurable_publisher_test.py"],
    libs: [
        // keep-sorted start
        "sdv_telemetry_test_execution_library",
        // keep-sorted end
    ],
    data: [
        // keep-sorted start
        ":sdv_test_fw_device_configs",
        // We need to prepend the test name to the file name, because using the
        // same file name across multiple e2e/sample tests appears to cause
        // conflicts resulting in compile failures.
        "sdv_sample_telemetry_configurable_publisher_test_metrics_config.textproto",
        // keep-sorted end
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
}
