package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

// SDV Test Framework ( sdv_test_fw ) library
python_library_host {
    name: "sdv_test_fw_lib",
    pkg_path: "sdv_test_fw",
    srcs: [
        "**/*.py",
    ],
    exclude_srcs: [
        "*_test.py",
    ],
    libs: [
        // Keep sorted.
        "absl-py", // Required for Parameterization in tests.
        "mobly", // Required for the framework.
        "pexpect", // Required for Interactive commands.
        "ptyprocess", // Required for Interactive commands.
        "py-httplib2", // Required for Host Orchestrator.
    ],
}

// SDV test defaults
python_defaults {
    name: "sdv_test_fw_defaults",
    libs: [
        "sdv_test_fw_lib",
    ],
    test_suites: [
        "catbox",
    ],
}
