# Generates metrics reports containing 5-seconds sampled speed when an `event`
# is published. If adjacent events take place within a 5 seconds range, they
# are considered to be a 'series of events`.
# This configuration allows reporting speed aggregated over a period of
# 5 seconds after the series' first and last event occur, as well as speed
# aggregated over a period of 5 seconds before **any** event occurs.
#
# This configuration uses two sources for storing event timestamps. When a
# new event is published, it stores its timestamp along with previous event
# timestamp to be able to deterministally find which event is the first one for
# a series.

uuid: "1c1a37e5-f03b-4e6d-bef0-3b91db4d46f8"
version: 3758096386
descriptor_protos {
  name: "adhoc.proto"
  package: "aaos.sdv.telemetry.adhoc"
  message_type {
    name: "series_first_event_timestamp_publisher"
    field { name: "timestamp" number: 1 type: TYPE_INT64 }
  }
  message_type {
    name: "speed_vector_aggregator"
    field { name: "vector" number: 1 label: LABEL_REPEATED type: TYPE_INT32 }
  }
  message_type {
    name: "new_event_timestamp_publisher"
    field { name: "timestamp" number: 1 type: TYPE_INT64 }
  }
  message_type {
    name: "on_new_event_aggregator"
    field { name: "previous_event_timestamp" number: 1 type: TYPE_INT64 }
    field { name: "events_count" number: 2 type: TYPE_INT32 }
  }
  message_type {
    name: "after_series_first_event_collected_data"
    field { name: "speed_vector" number: 1 label: LABEL_REPEATED type: TYPE_INT32 }
  }
  message_type {
    name: "after_series_last_event_collected_data"
    field { name: "speed_vector" number: 1 label: LABEL_REPEATED type: TYPE_INT32 }
  }
  message_type {
    name: "before_event_collected_data"
    field { name: "speed_vector" number: 1 label: LABEL_REPEATED type: TYPE_INT32 }
  }
  syntax: "proto2"
}
triggers {
  name: "event_series_start_trigger"
  conditional_trigger {
    trigger_names: "new_event_timestamp_updated_trigger"
    selector_node_index: 8
    is_true {}
  }
}
triggers {
  name: "event_trigger"
  data_trigger { source_name: "event_publisher" }
}
triggers {
  name: "new_event_timestamp_updated_trigger"
  data_trigger { source_name: "new_event_timestamp_publisher" }
}
triggers {
  name: "on_event_processed_trigger"
  data_trigger { source_name: "on_new_event_aggregator" }
}
triggers {
  name: "on_series_first_event_timer_trigger"
  conditional_trigger {
    trigger_names: "periodic_400ms"
    selector_node_index: 14
    rising_edge {}
  }
}
triggers {
  name: "on_series_last_event_timer_trigger"
  conditional_trigger {
    trigger_names: "periodic_400ms"
    selector_node_index: 11
    rising_edge {}
  }
}
triggers {
  name: "periodic_1s"
  periodic_trigger { interval { seconds: 1 } }
}
triggers {
  name: "periodic_400ms"
  periodic_trigger { interval { nanos: 400000000 } }
}
sources {
  name: "series_first_event_timestamp_publisher"
  aggregator {
    trigger_names: "event_series_start_trigger"
    message_builder {
      message_type: ".aaos.sdv.telemetry.adhoc.series_first_event_timestamp_"
                    "publisher"
      field_assignments {
        field_name: "timestamp"
        no_aggregation { expression_node_index: 9 }
      }
    }
  }
}
sources {
  name: "speed_publisher"
  data_source {
    source_identifier: ".google.sdv.telemetry_samples.SpeedMsg"
    connection_type: SUBSCRIPTION
  }
}
sources {
  name: "speed_vector_aggregator"
  aggregator {
    trigger_names: "periodic_1s"
    message_builder {
      message_type: ".aaos.sdv.telemetry.adhoc.speed_vector_aggregator"
      field_assignments {
        field_name: "vector"
        vector_aggregation { expression_node_index: 15 max_length: 5 }
      }
    }
  }
}
sources {
  name: "event_publisher"
  data_source {
    source_identifier: ".google.sdv.telemetry_samples.EventMsg"
    connection_type: SUBSCRIPTION
  }
}
sources {
  name: "new_event_timestamp_publisher"
  aggregator {
    trigger_names: "on_event_processed_trigger"
    message_builder {
      message_type: ".aaos.sdv.telemetry.adhoc.new_event_timestamp_publisher"
      field_assignments {
        field_name: "timestamp"
        no_aggregation { expression_node_index: 9 }
      }
    }
  }
}
sources {
  name: "on_new_event_aggregator"
  aggregator {
    trigger_names: "event_trigger"
    message_builder {
      message_type: ".aaos.sdv.telemetry.adhoc.on_new_event_aggregator"
      field_assignments {
        field_name: "previous_event_timestamp"
        no_aggregation { expression_node_index: 3 }
      }
      field_assignments {
        field_name: "events_count"
        count_aggregation {}
      }
    }
  }
}
