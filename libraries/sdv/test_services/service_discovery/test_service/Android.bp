package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: [
        "sdv_tests_license",
    ],
}

rust_binary {
    name: "service_discovery_test_service",
    crate_name: "sdv_service_discovery_test_service",
    srcs: ["src/service_discovery_test_service.rs"],
    rustlibs: [
        "google.sdv.service_discovery.discovery-V1-rust",
        "google.sdv.service_discovery.common-V1-rust",
        "google.sdv.identity-V1-rust",
        "libanyhow",
        "libbinder_rs",
        "libfutures_util",
        "libgrpcio",
        "liblog_rust",
        "libsdv_log_rust",
        "libservice_discovery_test_service_proto",
        "libtokio",
        "libvsock",
    ],
    shared_libs: [
        "libgrpc++",
        "libgrpc_wrap",
    ],
    vendor: true,
}
