service_name: ".google.sdv.telemetry_samples.WrappedMessage"
data_format_protos {
  name: "message.proto"
  package: "google.sdv.telemetry_samples"
  message_type {
    name: "WrappedMessage"
    field {
      name: "message"
      number: 1
      type: TYPE_MESSAGE
      type_name: ".google.sdv.telemetry_samples.Message"
    }
  }
  message_type {
    name: "Message"
    field { name: "int_value" number: 1 type: TYPE_INT32 }
    field {
      name: "float_value"
      number: 2
      type: TYPE_FLOAT

    }
    field {
      name: "string_value"
      number: 3
      type: TYPE_STRING

    }
  }
}
data_format_message_name: ".google.sdv.telemetry_samples.WrappedMessage"
data_generators {
  loop_data: false
  default_delay { seconds: 1 nanos: 0 }
  csv_file { file_path: "/data/local/tmp/publisher_data.csv" delimiter: "," }
}
