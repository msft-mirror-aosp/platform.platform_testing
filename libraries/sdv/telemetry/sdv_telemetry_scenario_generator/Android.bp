package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_tests_license"],
    default_visibility: ["//visibility:private"],
}

python_library_host {
    name: "sdv_telemetry_scenario_generator_library",
    visibility: ["//platform_testing/tests/sdv/e2e_tests/telemetry/kpi_scenario"],
    // `pkg_path` SHOULD match the folder name, otherwise autocomplete in IDEs
    // will not work.
    pkg_path: "sdv_telemetry_scenario_generator",
    srcs: [
        // keep-sorted start
        "file_descriptors.py",
        "generate.py",
        "generator_utils.py",
        // keep-sorted end
    ],
    libs: [
        // keep-sorted start
        "libprotobuf-python",
        "libsdv_telemetry_proto_python",
        "libsdv_telemetry_simulator_proto_python",
        // keep-sorted end
    ],
}

python_binary_host {
    name: "sdv_telemetry_scenario_generator",
    main: "main.py",
    srcs: [
        // keep-sorted start
        "main.py",
        // keep-sorted end
    ],
    libs: [
        // keep-sorted start
        "sdv_telemetry_scenario_generator_library",
        // keep-sorted end
    ],
}

python_test_host {
    name: "sdv_telemetry_scenario_generator_unit_tests",
    main: "test.py",
    srcs: [
        // keep-sorted start
        "test.py",
        // keep-sorted end
    ],
    libs: [
        // keep-sorted start
        "sdv_telemetry_scenario_generator_library",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        "sdv-host-unit-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}
