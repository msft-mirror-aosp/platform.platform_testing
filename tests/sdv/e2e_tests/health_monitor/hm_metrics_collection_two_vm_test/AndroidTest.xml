<configuration description="HM Health report performance metrics collection test - 2VMs">
  <option name="test-suite-tag" value="sdv-catbox" />

  <device name="device1">
    <!-- Extra dependencies required for the test. Only needed in first device. -->
    <!-- TODO(b/448843336): Use Android build libraries instead -->
    <!-- TODO(b/449630628): Remove when numpy import is replaced by AOSP library -->
    <target_preparer class="com.android.tradefed.targetprep.PythonVirtualenvPreparer">
      <!-- test specific: -->
      <option name="dep-module" value="numpy"/>
    </target_preparer>

    <!-- ADB Root -->
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />
  </device>

  <device name="device2">
    <!-- ADB Root -->
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />
  </device>

  <!-- Mobly test defaults for two devices -->
  <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
    <option name="mobly-par-file-name" value="SdvHmMetricsCollectionTwoVMTest" />
    <!-- Timeout limit in milliseconds -->
    <option name="mobly-test-timeout" value="300000" />
    <!-- Testbed config file -->
    <option name="mobly-config-file-name" value="sdv_two_devices_config_local.yaml" />
  </test>
</configuration>
