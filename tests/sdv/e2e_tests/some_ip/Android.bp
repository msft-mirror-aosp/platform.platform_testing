package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_test_host {
    name: "SdvSomeIpBrokerDumpsysTest",
    main: "someip_broker_dumpsys_test.py",
    srcs: ["someip_broker_dumpsys_test.py"],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_one_device",
}

python_test_host {
    name: "SdvSomeIpStackLoadIndicatorsTest",
    main: "someip_stack_load_indicators_test.py",
    srcs: ["someip_stack_load_indicators_test.py"],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_one_device",
}

// Performance tests. Require Perfetto.

python_test_host {
    name: "SdvSomeIpMultipubDeviceIntegrationTest",
    main: "someip_multipub_integration_test.py",
    srcs: ["someip_multipub_integration_test.py"],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
        "sdv_perfetto_defaults",
        "sdv_perfetto_trace_processor_defaults",
    ],
    test_config_template: ":sdv_one_device",
}

python_test_host {
    name: "SdvSomeIpBenchmarkTest",
    main: "someip_benchmark_test.py",
    srcs: ["someip_benchmark_test.py"],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
        "sdv_perfetto_trace_processor_defaults",
    ],
    test_config_template: ":sdv_one_device",
}
