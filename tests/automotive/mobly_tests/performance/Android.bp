package {
    default_team: "trendy_team_aaos_framework",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_library_host {
    name: "bluetooth_performance_test",
    pkg_path: "bluetooth_performance_test",
    srcs: ["bluetooth_performance_base_test.py"],
    libs: [
        "mobly",
        "utilities",
        "bluetooth_test",
        "statsd_collector",
        "libprotobuf-python",
    ],
    data: [
        "bluetooth_event_metrics.pb",
        "bt_connection_time.pb",
    ],
    device_common_data: [
        // Package the snippet with the mobly test
        ":AutomotiveSnippet",
        ":PhoneSnippet",
    ],
}

python_test_host {
    name: "BTPairingTest",
    main: "pairing_test.py",
    srcs: ["pairing_test.py"],
    libs: [
        "mobly",
        "utilities",
        "bluetooth_test",
    ],
    test_suites: [
        "catbox",
    ],
    test_options: {
        unit_test: false,
    },
    device_common_data: [
        // Package the snippet with the mobly test
        ":AutomotiveSnippet",
        ":PhoneSnippet",
        "bt_performance_10_iterations.yaml",
    ],
}

python_test_host {
    name: "BTConnectionPerformanceTest",
    main: "connection_test.py",
    srcs: ["connection_test.py"],
    libs: [
        "bluetooth_performance_test",
    ],
    test_suites: [
        "catbox",
    ],
    test_options: {
        unit_test: false,
    },
    device_common_data: [
        // Package the snippet with the mobly test
        ":AutomotiveSnippet",
        ":PhoneSnippet",
        "bt_performance_10_iterations.yaml",
        "bluetooth_event_metrics.pb",
        "bt_connection_time.pb",
    ],
}

python_test_host {
    name: "BTPerformanceDialerJankTest",
    main: "dialer_jank_test.py",
    srcs: ["dialer_jank_test.py"],
    libs: [
        "mobly",
        "utilities",
        "bluetooth_test",
        "jank_collector",
    ],
    test_suites: [
        "catbox",
    ],
    test_options: {
        unit_test: false,
    },
    device_common_data: [
        // Package the snippet with the mobly test
        ":AutomotiveSnippet",
        ":PhoneSnippet",
        "dialer_jank_performance_20_iterations.yaml",
        "contacts_test.vcf",
    ],
}
