package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_test_host {
    name: "SdvE2EUMDroppedSubscriberTest",
    main: "sdv_e2e_um_dropped_subscriber_test.py",
    srcs: [
        "sdv_e2e_um_dropped_subscriber_test.py",
    ],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    device_first_data: [
        ":com.android.sdv.sample.apex.provider.v2",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_one_device",
}

