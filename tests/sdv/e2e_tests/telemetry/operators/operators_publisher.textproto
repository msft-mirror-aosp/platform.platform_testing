service_name: ".google.sdv.telemetry_samples.OperatorsTestdata"
data_format_protos {
  name: "operators.proto"
  package: "google.sdv.telemetry_samples"
  message_type {
    name: "OperatorsTestdata"
    field { name: "integer" number: 1 type: TYPE_INT32 json_name: "integer" }
    field { name: "float" number: 2 type: TYPE_FLOAT json_name: "float" }
    field { name: "boolean" number: 3 type: TYPE_BOOL json_name: "boolean" }
  }
}
data_format_message_name: ".google.sdv.telemetry_samples.OperatorsTestdata"
data_generators {
  loop_data: false
  default_delay { seconds: 1 nanos: 0 }
  csv_file { file_path: "/data/local/tmp/operators_publisher_data.csv" delimiter: "," }
}
