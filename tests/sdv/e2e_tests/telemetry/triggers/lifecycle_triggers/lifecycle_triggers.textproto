uuid: "27f28563-9352-4f39-86d9-d5e67e793084"
version: 3758096386
descriptor_protos {
  name: "adhoc.proto"
  package: "aaos.sdv.telemetry.adhoc"
  message_type {
    name: "aggregator"
    field { name: "value" number: 1 label: LABEL_REPEATED type: TYPE_INT32 }
  }
  message_type {
    name: "report"
    field { name: "value" number: 1 label: LABEL_REPEATED type: TYPE_INT32 }
  }
  syntax: "proto2"
}
triggers {
  name: "data_trigger"
  data_trigger { source_name: "publisher" }
}
triggers {
  name: "end_trigger"
  periodic_trigger { interval { nanos: 400000000 } }
}
triggers {
  name: "finish_trigger"
  periodic_trigger { interval { seconds: 2 } }
}
triggers {
  name: "start_trigger"
  periodic_trigger { interval { nanos: 500000000 } }
}
sources {
  name: "publisher"
  data_source {
    source_identifier: ".google.sdv.telemetry_samples.LifecycleTriggers"
    connection_type: SUBSCRIPTION
  }
}
sources {
  name: "aggregator"
  aggregator {
    trigger_names: "data_trigger"
    message_builder {
      message_type: ".aaos.sdv.telemetry.adhoc.aggregator"
      field_assignments {
        field_name: "value"
        vector_aggregation { expression_node_index: 0 }
      }
    }
  }
}
# Expression Node 0
expression_nodes { field_leaf_node { source_name: "publisher" field_names: "integer" } }
# Expression Node 1
expression_nodes { field_leaf_node { source_name: "aggregator" field_names: "value" } }
metrics_report_configs {
  name: "report"
  report_incomplete: true
  message_builder {
    message_type: ".aaos.sdv.telemetry.adhoc.report"
    field_assignments {
      field_name: "value"
      no_aggregation { expression_node_index: 1 }
    }
  }
}
start_trigger_name: "start_trigger"
stop_trigger_name: "end_trigger"
deactivate_trigger_name: "finish_trigger"
