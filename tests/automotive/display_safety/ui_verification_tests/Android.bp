    data: [
        ":spectatio_host_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "spectatio_host_tf_defaults",
    ],
    libs: [
        "display_safety_test_lib",
    ],
    test_config_template: ":display_safety_test_config_one_device",
}
