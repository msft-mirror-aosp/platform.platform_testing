package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["sdv_tests_license"],
}

// SDV sample 'CUJ-Rob-051-IVI' test.
python_test_host {
    name: "SdvLongRunningCujRob051IviTest",
    main: "sdv_long_running_cuj_rob_051_ivi_test.py",
    srcs: ["sdv_long_running_cuj_rob_051_ivi_test.py"],
    data: [":sdv_test_fw_device_configs"],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    libs: [
        "sdv_sb_lifecycle_robustness_lib",
        "sdv_ivi_rob_base_test_lib",
    ],
    // Root access required for issuing LCM commands.
    // The test runs for ca. 7 min: robustness tests require 100 repetitions.
    test_config_template: ":sdv_two_devices_long_running_test",
}
