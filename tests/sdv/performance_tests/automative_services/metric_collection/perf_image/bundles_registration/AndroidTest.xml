<configuration description="SDV Bundle Management metric collection test suite">
  <option name="test-suite-tag" value="sdv-catbox" />

  <!-- Extra dependencies required for the test -->
  <!-- TODO(b/448843336): Use Android build libraries instead -->
  <!-- TODO(b/449630628): Remove when numpy import is replaced by AOSP library -->
  <target_preparer class="com.android.tradefed.targetprep.PythonVirtualenvPreparer">
    <option name="dep-module" value="numpy" />
  </target_preparer>

  <!-- ADB Root -->
  <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />

  <!-- Mobly test defaults for one device -->
  <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
      <option name="mobly-par-file-name" value="BundleManagementMetricsCollectionTest" />
      <!-- Timeout limit in milliseconds -->
      <!-- Test requires higher timeout as it collects logs over multiple device reboots. Due to
      longer runtime, test should be always run from postsubmit only  -->
      <option name="mobly-test-timeout" value="600000" />
      <!-- Testbed config file -->
      <option name="mobly-config-file-name" value="sdv_one_device_config.yaml" />
  </test>
</configuration>
