version: 1

descriptor_protos {
  message_type {
    name: "Report"
    field { name: "value" number: 1 label: LABEL_OPTIONAL type: TYPE_UINT32 }
  }
}

publishers {
  name: "publisher_a"
  service_publisher {
    # This uses a different unit name ("flmtrue"), and, thus, a different DT
    # topic, than the other publisher.
    service_name: "com.google.sdv.telemetry.tests."
                  "DtPublisherForFetchLastMessageE2ETest#Value|flmtrue"
    connection_type: SUBSCRIPTION
    fetch_last_message: true
  }
}

publishers {
  name: "publisher_b"
  service_publisher {
    # This uses a different unit name ("flmfalse"), and, thus, a different DT
    # topic, than the other publisher.
    service_name: "com.google.sdv.telemetry.tests."
                  "DtPublisherForFetchLastMessageE2ETest#Value|flmfalse"
    connection_type: SUBSCRIPTION
    fetch_last_message: false
  }
}

triggers {
  name: "trigger_3s"
  periodic_trigger { interval { seconds: 3 } }
}

# index 0
expression_nodes { field_leaf_node { publisher_name: "publisher_a" field_names: "value" } }

# index 1
expression_nodes { field_leaf_node { publisher_name: "publisher_b" field_names: "value" } }

finish_trigger_name: "trigger_3s"

metrics_report_configs {
  name: "report_flm_true"
  trigger_names: "trigger_3s"
  report_incomplete: false

  message_builder {
    message_type: ".Report"
    field_assignments {
      field_name: "value"
      no_aggregation { expression_node_index: 0 }
    }
  }
}

metrics_report_configs {
  name: "report_flm_false"
  trigger_names: "trigger_3s"
  report_incomplete: false

  message_builder {
    message_type: ".Report"
    field_assignments {
      field_name: "value"
      no_aggregation { expression_node_index: 1 }
    }
  }
}
