package {
    default_applicable_licenses: ["sdv_tests_license"],
    default_team: "trendy_team_auto_engprod",
}

python_test_host {
    name: "sdv_host_test_framework_unit_verification_polling_test",
    srcs: ["polling_test.py"],
    main: "polling_test.py",
    libs: ["sdv_test_fw_lib"],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
