<configuration description="SDV Three Devices Test (Long Running): {MODULE}">
   <!--
    Template for SDV Long Running Tests: Three devices

    Only use for dedicated long-running tests. This configuration is intended
    for tests that require a dedicated long execution time and should not be
    used otherwise. See b/431976072 for details.
  -->
  <option name="test-suite-tag" value="sdv-catbox" />

  <device name="device1">
    <!-- ADB Root -->
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />
  </device>

  <device name="device2">
    <!-- ADB Root -->
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />
  </device>

  <device name="device3">
    <!-- ADB Root -->
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />
  </device>


  <!-- Mobly test defaults for three devices -->
  <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
    <option name="mobly-par-file-name" value="{MODULE}" />
    <!-- Long Running Test - 30 hours timeout: for long running tests -->
    <!-- Note: Currently, only 10 hours of execution is possible in CI/CD (b/431979898) -->
    <option name="mobly-test-timeout" value="108000000" />
    <!-- Testbed config file -->
    <option name="mobly-config-file-name" value="sdv_three_devices_config.yaml" />
  </test>
</configuration>
