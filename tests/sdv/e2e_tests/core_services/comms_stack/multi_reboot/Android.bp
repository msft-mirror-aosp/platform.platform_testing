package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_test_host {
    name: "SdvCommsStackMultiRebootTestOrchConfig_0_0_10",
    main: "sdv_comm_stack_multi_reboot_test_orch_config_0_0_10.py",
    srcs: [
        "sdv_comm_stack_multi_reboot_test_orch_config_0_0_10.py",
        "sdv_comm_stack_multi_reboot_test_orch_config_base.py",
    ],
    libs: [
        "cuj22_common_lib",
    ],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: "multi-reboot-exception-template.xml",
}

