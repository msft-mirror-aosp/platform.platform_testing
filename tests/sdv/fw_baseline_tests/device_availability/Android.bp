package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["sdv_tests_license"],
}

// One VM test
python_test_host {
    name: "SdvOneDeviceAvailabilityTest",
    main: "sdv_device_availability_1vm_test.py",
    srcs: [
        "device_availability_common.py",
        "sdv_device_availability_1vm_test.py",
    ],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_one_device",
}

