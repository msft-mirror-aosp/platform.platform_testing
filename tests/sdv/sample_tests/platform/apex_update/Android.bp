package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["sdv_tests_license"],
}

python_test_host {
    name: "SdvSampleApexUpdateTest",
    main: "sdv_sample_apex_update_test.py",
    srcs: ["sdv_sample_apex_update_test.py"],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    device_first_data: [
        ":com.sdv.google.sample.apex.provider.v2",
        ":com.sdv.google.sample.apex.consumer.v2",
        ":com.sdv.google.sample.test1.v2",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_one_device",
}

python_test_host {
    name: "SdvSampleIviApexUpdateTest",
    main: "sdv_sample_ivi_apex_update_test.py",
    srcs: ["sdv_sample_ivi_apex_update_test.py"],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    device_first_data: [
        ":com.sdv.google.sample.apex.provider.v2",
        ":com.sdv.google.sample.ivi.service.v2",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_two_devices",
}

python_test_host {
    name: "SdvSampleBrandNewApexTest",
    main: "sdv_sample_brand_new_apex_test.py",
    srcs: ["sdv_sample_brand_new_apex_test.py"],
    data: [
        ":sdv_test_fw_device_configs",
    ],
    device_first_data: [
        ":com.sdv.google.sample.hello.brand_new.blocked",
        ":com.sdv.google.sample.hello.brand_new.allowed",
    ],
    test_options: {
        unit_test: false,
    },
    defaults: [
        "sdv_test_fw_defaults",
    ],
    test_config_template: ":sdv_one_device",
}
