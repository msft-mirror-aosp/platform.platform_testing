<configuration description="SDV One Device Test (Long): {MODULE}">
  <!--
      Template for SDV One Device Test.
      This is common for all tests. Do not modify.
  -->
  <option name="test-suite-tag" value="sdv-catbox" />

  <!-- ADB Root -->
  <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />

  <!-- Mobly test defaults for one device -->
  <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
      <option name="mobly-par-file-name" value="{MODULE}" />
      <!-- Long test. Timeout limit in milliseconds -->
      <option name="mobly-test-timeout" value="600000" />
      <!-- Testbed config file -->
      <option name="mobly-config-file-name" value="sdv_one_device_config_local.yaml" />
  </test>
</configuration>