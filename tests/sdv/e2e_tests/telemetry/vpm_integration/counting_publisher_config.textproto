service_name: "SimulationCountingPublisher"
data_format_protos {
  message_type {
    name: "Data"
    field { name: "value" json_name: "value" number: 1 type: TYPE_INT64 }
  }
}
data_format_message_name: ".Data"
data_generators {
  loop_data: true
  default_delay { seconds: 1 }
  csv_file { file_path: "/data/local/counting_publisher_data.csv" delimiter: "," }
}
