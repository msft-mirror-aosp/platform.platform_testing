<configuration description="SDV Two Devices Test (Long): {MODULE}">
  <option name="test-suite-tag" value="sdv-catbox" />

  <device name="device1">
    <!-- ADB Root -->
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />
  </device>

  <device name="device2">
    <!-- ADB Root -->
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />
  </device>

  <!-- Mobly test defaults for two devices -->
  <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
    <option name="mobly-par-file-name" value="SdvServiceBundleMemLeakTest" />
    <!-- Long test. Timeout limit in milliseconds -->
    <option name="mobly-test-timeout" value="36000000" />
    <!-- Testbed config file -->
    <option name="mobly-config-file-name" value="sdv_two_devices_config_local.yaml" />
    <!-- Test args passed to the test  -->
    <option name="mobly-options" value="--test_args=trace_config=service_bundle_mem_trace.pbtxt" />
     <option name="mobly-options" value="--test_args=start_stop_repeated_times=100" />
    <option name="mobly-options" value="--test_args=interval_ms=30" />
    <option name="mobly-options" value="--test_args=load_size_bytes=300000" />
    <option name="mobly-options" value="--test_args=message_amount=10" />
  </test>
</configuration>