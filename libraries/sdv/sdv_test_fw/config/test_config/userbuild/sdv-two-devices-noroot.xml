<configuration description="SDV Two No Root Devices Test: {MODULE}">
   <!--
      Template for SDV no-rooted Two Devices Test.
      This is not a common template and is used for specific tests without
      root enabled.
      This configuration can be used in User Build testing,
      where devices never have root, but only adb enabled.
  -->
  <option name="test-suite-tag" value="sdv-catbox" />

  <device name="device1"/>

  <device name="device2"/>

  <!-- Mobly test defaults for two devices -->
  <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
    <option name="mobly-par-file-name" value="{MODULE}" />
    <!-- Timeout limit in milliseconds -->
    <option name="mobly-test-timeout" value="300000" />
    <!-- Testbed config file -->
    <option name="mobly-config-file-name" value="sdv_two_devices_config_local.yaml" />
  </test>
</configuration>
