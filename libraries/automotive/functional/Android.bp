package {
    default_team: "trendy_team_auto_engprod",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_library_host {
    name: "functional_test_library",
    pkg_path: "functional_test",
    srcs: [
        "test_base/*.py",
    ],
    libs: [
        "file_utils_library",
        "image_comparison_library",
        "screenshot_util_library",
        "spectatio_host_tf_lib",
    ],
    defaults: [
        "spectatio_host_tf_defaults",
    ],
}
